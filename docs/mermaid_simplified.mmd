%% ============================================================
%% markloc 识别流水线 — 简化版 Mermaid 代码
%% 面向新手，去掉技术细节，只保留理解的骨架
%% 复制任一图块（去掉注释）粘贴到 mermaid.live / GitHub / VS Code
%% ============================================================


%% ============================================================
%% 【简化图 1】七步流水线（推荐用这张）
%% ============================================================
flowchart TD
    A["一张芯片照片"] --> B["① 框出四个有字的地方"]
    B --> C["② 抹掉背景明暗<br/>只留突出来的笔画"]
    C --> D["③ 对齐到模型位置<br/>顺便判断对齐得好不好"]
    D --> E["④ 划出安全区<br/>本来该有笔画的地方"]
    E --> F["⑤ 在安全区之外找可疑痕迹"]
    F --> G["⑥ 看形状分类"]
    G --> G1["细长条<br/>多刻的笔画"]
    G --> G2["直直线<br/>划痕"]
    G --> G3["特别粗<br/>工号糊了"]
    G1 --> H["⑦ 打分"]
    G2 --> H
    G3 --> H
    H --> I{"对齐好吗"}
    I -->|不好| J["这个区域不算数"]
    I -->|好| K["区域分 = 三项最高"]
    J --> L["视角分 = 四区域最高"]
    K --> L
    L --> M["零件分 = 六视角最高"]
    M --> N{"超过 1.0 ?"}
    N -->|是| O["NG 不良"]
    N -->|否| P["OK 合格"]


%% ============================================================
%% 【简化图 2】一句话版本
%% ============================================================
flowchart LR
    A["抹平背景"] --> B["围出该有字的区域"]
    B --> C["检查区域外面有没有多余东西"]
    C --> D["按形状分三类打分"]
    D --> E["六视角取最高分"]
    E --> F{"超过 1.0 ?"}
    F -->|是| G["NG"]
    F -->|否| H["OK"]


%% ============================================================
%% 【简化图 3】三个缺陷检查的分岔（第 6 步展开）
%% ============================================================
flowchart TD
    A["可疑痕迹"] --> B{"什么形状"}
    B -->|细长条| C["多余笔画"]
    B -->|直线| D["划痕"]
    B -->|成团变粗| E["工号崩缺"]

    C --> C1["面积至少 15 像素<br/>长宽比超过 2.2"]
    D --> D1["这条线上有残差的比例 ≥ 25%"]
    D --> D2["长度至少 160 像素"]
    E --> E1["比正常笔画粗很多的地方<br/>占多大比例"]

    C1 --> F["除以各自的归一化分母<br/>变成可比的分数"]
    D1 --> F
    D2 --> F
    E1 --> F
    F --> G["区域分 = 三者最高"]


%% ============================================================
%% 【简化图 4】为什么六个视角取最高
%% ============================================================
flowchart TD
    A["同一颗芯片<br/>六次不同打光"] --> B["视角 1 独立打分"]
    A --> C["视角 2 独立打分"]
    A --> D["视角 3 独立打分"]
    A --> E["... 共六个"]
    B --> F["取最高分"]
    C --> F
    D --> F
    E --> F
    F --> G{"超过 1.0 ?"}
    G -->|是| H["NG"]
    G -->|否| I["OK"]
    H --> J["一个说不合格<br/>就是不合格"]
